# RMMZit server configuration. Restart after changes:
#   systemctl restart rmmzit-server

# PostgreSQL connection (required; install.sh fills it in).
RMMZIT_DB=postgres://rmmzit:CHANGE_ME@127.0.0.1:5432/rmmzit?sslmode=disable

# Where updates come from (default: the official GitHub releases). A mirror
# or a local directory (file:///srv/rmmzit-releases) holds the files of
# a release side by side; they must still carry the release signature.
#RMMZIT_UPDATE_SOURCE=
