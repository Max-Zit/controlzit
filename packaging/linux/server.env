# ControlZit server configuration. Restart after changes:
#   systemctl restart controlzit-server

# PostgreSQL connection (required; install.sh fills it in).
CONTROLZIT_DB=postgres://controlzit:CHANGE_ME@127.0.0.1:5432/controlzit?sslmode=disable

# Where updates come from (default: the official GitHub releases). A mirror
# or a local directory (file:///srv/controlzit-releases) holds the files of
# a release side by side; they must still carry the release signature.
#CONTROLZIT_UPDATE_SOURCE=
