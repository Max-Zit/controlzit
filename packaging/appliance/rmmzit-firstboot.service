[Unit]
Description=Set up RMMZit on the first start of the appliance
After=network-online.target postgresql.service
Wants=network-online.target
Before=getty@tty1.service
ConditionPathExists=!/var/lib/rmmzit/.appliance-ready

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/rmmzit-firstboot
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
