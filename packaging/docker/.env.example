# Copy to .env next to docker-compose.yml and fill in.

# Database password: letters and digits only, e.g. from: openssl rand -hex 24
DB_PASSWORD=

# Time zone for schedules and reports, e.g. Europe/Belgrade.
TZ=UTC

# Image tag: latest (official releases), testing (release candidates) or a version such as 0.13.0.
RMMZIT_TAG=latest
